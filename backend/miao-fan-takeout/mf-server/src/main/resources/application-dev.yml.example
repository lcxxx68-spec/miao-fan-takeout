# 复制本文件为 application-dev.yml 后,把下面各项替换成你自己的配置。
# application-dev.yml 已被 .gitignore 忽略,不会提交到仓库。
miaofan:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: miaofan_takeout
    username: root
    password: 你的数据库密码
  alioss:
    # 阿里云 OSS,用于菜品图片上传。不用上传功能可以留空
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: 你的AccessKeyId
    access-key-secret: 你的AccessKeySecret
    bucket-name: 你的Bucket名称
  redis:
    host: localhost
    port: 6379
    database: 0
  wechat:
    # 微信小程序凭据,用于用户端微信登录。不登录用户端可以留空
    appid: 你的小程序AppID
    secret: 你的小程序AppSecret
