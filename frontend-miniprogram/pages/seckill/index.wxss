/* 限时抢购 · 与后台管理端保持同一套橙色视觉 */

page {
    background: #f5f5f7;
}

.page {
    min-height: 100vh;
    padding: 24rpx 24rpx 60rpx;
    box-sizing: border-box;
}

.hero {
    display: flex;
    align-items: center;
    padding: 30rpx 32rpx;
    margin-bottom: 24rpx;
    border-radius: 28rpx;
    background: linear-gradient(135deg, #f97316 0%, #c2410c 100%);
    box-shadow: 0 12rpx 32rpx rgba(194, 65, 12, .25);
}

.hero-logo {
    width: 96rpx;
    height: 96rpx;
    border-radius: 24rpx;
    background: #fff;
}

.hero-text {
    margin-left: 24rpx;
}

.hero-title {
    font-size: 38rpx;
    font-weight: 600;
    color: #fff;
    letter-spacing: 2rpx;
}

.hero-sub {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: rgba(255, 255, 255, .85);
}

.state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 140rpx 0;
}

.state-loading {
    width: 120rpx;
    height: 120rpx;
    border-radius: 26rpx;
    animation: mf-pulse 1.2s ease-in-out infinite;
}

@keyframes mf-pulse {
    0%, 100% { opacity: .5; transform: scale(.94); }
    50% { opacity: 1; transform: scale(1); }
}

.state-text {
    font-size: 30rpx;
    color: #6e6e73;
}

.state-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #8e8e93;
}

.card {
    display: flex;
    align-items: center;
    padding: 24rpx;
    margin-bottom: 20rpx;
    border-radius: 24rpx;
    background: #fff;
    box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, .05);
}

.card-img {
    width: 150rpx;
    height: 150rpx;
    border-radius: 20rpx;
    background: #f5f5f7;
    flex-shrink: 0;
}

.card-body {
    flex: 1;
    min-width: 0;
    margin-left: 22rpx;
}

.card-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #1d1d1f;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.card-price {
    display: flex;
    align-items: baseline;
    margin-top: 12rpx;
}

.price-now {
    font-size: 38rpx;
    font-weight: 600;
    color: #ea580c;
}

.price-old {
    margin-left: 14rpx;
    font-size: 24rpx;
    color: #8e8e93;
    text-decoration: line-through;
}

.card-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #8e8e93;
}

.meta-stock.low {
    color: #dc2626;
    font-weight: 600;
}

.card-action {
    margin-left: 18rpx;
    flex-shrink: 0;
}

.card-btn {
    min-width: 168rpx;
    height: 68rpx;
    padding: 0 24rpx;
    border-radius: 34rpx;
    background: #f97316;
    color: #fff;
    font-size: 28rpx;
    line-height: 68rpx;
    border: none;
}

.card-btn::after {
    border: none;
}

.card-btn.disabled {
    background: #e5e5ea;
    color: #8e8e93;
}

.tips {
    margin-top: 20rpx;
    text-align: center;
    font-size: 22rpx;
    color: #8e8e93;
    line-height: 1.7;
}
